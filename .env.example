# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role"

# Evolution API / Baileys WhatsApp Engine
WHATSAPP_API_URL="http://localhost:8080"
WHATSAPP_API_KEY="sua-api-key-evolution"
WHATSAPP_INSTANCE_NAME="veloce-studio-01"

# Pix Anti-No-Show Gateway (Mercado Pago / Asaas)
PIX_PROVIDER="mercadopago"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-0000000000000000"
ASAAS_API_KEY="$aact_0000000000000000"
PIX_WEBHOOK_SECRET="whsec_veloce_anti_noshow"

# Cloudflare R2 Object Storage (Upload de Fotos e Prontuários com Zero Egress)
CLOUDFLARE_R2_ACCOUNT_ID="seu_account_id_cloudflare"
CLOUDFLARE_R2_ACCESS_KEY_ID="sua_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="sua_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="agendaste-storage"
# URL pública do bucket (R2 Dev domain habilitado ou Custom Domain, ex: https://pub-xxxxxx.r2.dev ou https://fotos.agendaste.com.br)
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"

